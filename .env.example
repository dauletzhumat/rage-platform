# RAGE Platform — environment template. Copy to `.env` (never commit `.env`).
# Values below are LOCAL DEVELOPMENT placeholders only.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (docker compose or tools/local-services) ---
# Two roles (ADR-016, docs/AUTH.md §11):
#   owner `rage`     — runs migrations, `db:grants` and seeds (MIGRATION_DATABASE_URL);
#   app   `rage_app` — used by the running API (DATABASE_URL): DML only, append-only
#                      tables (audit_logs, match_events) are INSERT/SELECT only.
# `rage_app` is created/updated by `pnpm --filter @rage/db db:grants` (run as owner AFTER
# `pnpm db:migrate`). Until you have run it, the API cannot connect with DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://rage:rage_dev_password@127.0.0.1:5432/rage?schema=public
DATABASE_URL=postgresql://rage_app:rage_app_dev_password@127.0.0.1:5432/rage?schema=public
# Password `db:grants` sets on the app role; must match the password in DATABASE_URL.
# Rotate: change both, re-run db:grants, restart the API.
RAGE_APP_DB_PASSWORD=rage_app_dev_password
# Optional app role name override (default rage_app); must match the user in DATABASE_URL.
# RAGE_APP_DB_ROLE=rage_app
# Separate database used by integration tests (wiped/migrated by tests) — OWNER role,
# because tests reset schemas.
TEST_DATABASE_URL=postgresql://rage:rage_dev_password@127.0.0.1:5432/rage_test?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- API (NestJS) ---
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of browser origins allowed to call the API with credentials.
API_CORS_ORIGINS=http://localhost:3000
# Expose Swagger UI at /api/docs (disable in production unless protected).
API_DOCS_ENABLED=true

# --- Web (Next.js) ---
# Browser-visible API base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
# Server-side (SSR) API base URL; inside docker compose this is http://api:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Object storage (S3-compatible; demos/logos) — used from M5 ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=rage-local
S3_ACCESS_KEY_ID=rage_dev_access_key
S3_SECRET_ACCESS_KEY=rage_dev_secret_key
S3_FORCE_PATH_STYLE=true

# --- Steam OpenID sign-in & sessions — M1 (docs/AUTH.md §2) ---
# Generate every secret below with (32 random bytes, base64url):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit real values. While realm/return URL/SESSION_SECRET are empty or invalid the
# API reports features.steamAuth.status=unconfigured in /api/v1/meta and auth routes return 503.
#
# Absolute origin of the web app; post-login redirect target. Must be in API_CORS_ORIGINS.
WEB_PUBLIC_URL=http://localhost:3000
# OpenID realm (origin Steam shows to the user) and the callback URL, which must live under
# the realm. Production requires https. If Steam rejects localhost, use an HTTPS tunnel
# (docs/RUNBOOK.md "Steam sign-in (M1) local setup").
STEAM_OPENID_REALM=http://localhost:4000
STEAM_OPENID_RETURN_URL=http://localhost:4000/api/v1/auth/steam/callback
# HMAC key for OpenID state/CSRF binding (>= 32 random bytes). REQUIRED for Steam sign-in.
# Generate with the command above. Leave empty to keep Steam sign-in disabled.
SESSION_SECRET=
# Absolute / idle session lifetime in hours (defaults 336 = 14 days / 72).
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=72
# Secure cookie flag. Default: true in production, false otherwise (plain http://localhost).
# COOKIE_SECURE=false
# Optional: Steam Web API key (https://steamcommunity.com/dev/apikey) for display name/avatar
# sync. Server-side only, never sent to the browser. Never used for authorization.
STEAM_WEB_API_KEY=
# Optional: YOUR individual SteamID64 (17 digits). Its first verified Steam login receives
# SUPER_ADMIN (ADR-017). One-shot: removing it later does not revoke the grant, and a grant
# revoked by another SUPER_ADMIN is never re-issued while it is still set.
BOOTSTRAP_SUPER_ADMIN_STEAM_ID64=
# Shared secret between the web server (SSR) and the API (docs/AUTH.md §8), >= 32 random
# bytes; the SAME value must be given to api and web. Read by web at runtime, server-side
# only (never NEXT_PUBLIC_). Generate with the command above. Required in production.
INTERNAL_SSR_TOKEN=
# Web server: number of reverse proxies in front of Next.js that APPEND to X-Forwarded-For
# (docs/AUTH.md §8). 0 (default) = never forward a visitor IP to the API (all SSR traffic
# shares one rate-limit bucket). Set to the real hop count in production; never higher.
# WEB_TRUST_PROXY_HOPS=0

# --- Docker Compose overrides (optional; compose defaults to the values shown) ---
# POSTGRES_USER=rage
# POSTGRES_PASSWORD=rage_dev_password
# POSTGRES_DB=rage
# POSTGRES_TEST_DB=rage_test
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# S3_HOST_PORT=9000
# API_HOST_PORT=4000
# WEB_HOST_PORT=3000
# NODE_ENV of the compose `api` container. `production` requires https:// API_CORS_ORIGINS.
# API_CONTAINER_NODE_ENV=development
