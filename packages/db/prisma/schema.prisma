// RAGE Platform — PostgreSQL data model (source of truth: docs/SCHEMA.md).
//
// Conventions
// - Models: PascalCase singular, mapped to snake_case plural tables via @@map.
// - Fields: camelCase, mapped to snake_case columns via @map.
// - Primary keys: UUID (v7, generated by Prisma Client — raw SQL inserts must supply `id`).
// - Timestamps: timestamptz(6).
// - Constraints Prisma cannot express (CHECKs, partial/expression unique indexes,
//   append-only triggers) live as raw SQL in the migrations. See packages/db/README.md.
// - Rows created by `seed:sample` carry `is_sample = true` (users, teams, tournaments, matches).
//
// Prisma 7: the datasource URL is configured in prisma.config.ts, and the runtime client
// requires a driver adapter (@prisma/adapter-pg) — see src/client.ts.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SteamPrivacyStatus {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
  UNKNOWN
}

/// Platform roles granted via user_role_grants (players/captains are implicit, not grants).
enum RoleType {
  SUPER_ADMIN
  TOURNAMENT_ADMIN
  MATCH_ADMIN
  OBSERVER
  TEAM_MANAGER
}

enum RoleScopeType {
  GLOBAL
  TEAM
  TOURNAMENT
  MATCH
}

enum TeamApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DISBANDED
}

enum MembershipRole {
  CAPTAIN
  PLAYER
  SUBSTITUTE
  MANAGER
  COACH
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum StaffRole {
  COACH
  ASSISTANT_COACH
  ANALYST
  MANAGER
}

enum BracketFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RosterStatus {
  DRAFT
  LOCKED
  SUPERSEDED
}

enum RosterEntryRole {
  STARTER
  SUBSTITUTE
}

enum MatchFormat {
  BO1
  BO3
  BO5
}

/// Series state machine (validated by the API):
/// CREATED → SERVER_ASSIGNED → PREPARING → WARMUP → READY_CHECK → KNIFE? → LIVE ↔ PAUSED
/// → MAP_FINISHED → (next map: WARMUP …) → COMPLETED; branches CANCELLED / FAILED / DISPUTED.
enum MatchStatus {
  CREATED
  SERVER_ASSIGNED
  PREPARING
  WARMUP
  READY_CHECK
  KNIFE
  LIVE
  PAUSED
  MAP_FINISHED
  COMPLETED
  CANCELLED
  FAILED
  DISPUTED
}

enum MatchMapStatus {
  PENDING
  WARMUP
  KNIFE
  LIVE
  PAUSED
  FINISHED
  CANCELLED
}

/// Which side of a match/bracket pairing (team A or team B).
enum TeamPosition {
  A
  B
}

enum TeamSide {
  CT
  T
}

enum VetoActionType {
  BAN
  PICK
  SIDE_PICK
  DECIDER
}

enum RoundWinReason {
  ELIMINATION
  BOMB_EXPLODED
  BOMB_DEFUSED
  TIME_EXPIRED
  SURRENDER
  ADMIN_DECISION
  UNKNOWN
}

enum ServerProviderType {
  DEDICATED
  VPS
  LAN
}

enum GameServerStatus {
  UNKNOWN
  AVAILABLE
  RESERVED
  IN_USE
  MAINTENANCE
  OFFLINE
  ERROR
}

enum ServerAgentStatus {
  PENDING
  ONLINE
  DEGRADED
  OUTDATED
  OFFLINE
  REVOKED
}

/// Strict allowlist of admin/server commands. There is intentionally NO free-form
/// command or RCON text anywhere in the schema; typed parameters go in `payload` (JSON).
/// Adding a command requires a migration + adapter implementation + review.
enum ServerCommandType {
  HEALTH_CHECK
  LOAD_MATCH_CONFIG
  START_MATCH
  PAUSE_MATCH
  UNPAUSE_MATCH
  RESTORE_ROUND_BACKUP
  END_MATCH
  RELEASE_SERVER
}

enum ServerCommandState {
  QUEUED
  SENT
  ACKNOWLEDGED
  FAILED
  TIMED_OUT
}

enum DemoStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

// ============================================================================
// Identity
// ============================================================================

model User {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Verified SteamID64 (17 decimal digits). Immutable identity; CHECK enforced in SQL.
  steamId64   String     @unique @map("steam_id64") @db.VarChar(17)
  status      UserStatus @default(ACTIVE)
  isSample    Boolean    @default(false) @map("is_sample")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)

  sessions          AuthSession[]
  steamProfile      SteamProfile?
  playerProfile     PlayerProfile?
  roleGrants        UserRoleGrant[] @relation("RoleGrantUser")
  roleGrantsIssued  UserRoleGrant[] @relation("RoleGrantIssuer")
  roleGrantsRevoked UserRoleGrant[] @relation("RoleGrantRevoker")

  teamApplications         TeamApplication[] @relation("ApplicationApplicant")
  teamApplicationsReviewed TeamApplication[] @relation("ApplicationReviewer")
  memberships              TeamMembership[]  @relation("MembershipUser")
  membershipsInvited       TeamMembership[]  @relation("MembershipInviter")
  invitationsReceived      TeamInvitation[]  @relation("InvitationInvitee")
  invitationsSent          TeamInvitation[]  @relation("InvitationInviter")
  staffPositions           TeamStaff[]

  tournamentsCreated     Tournament[]             @relation("TournamentCreator")
  registrationsRequested TournamentRegistration[] @relation("RegistrationRequester")
  registrationsReviewed  TournamentRegistration[] @relation("RegistrationReviewer")
  rostersLocked          TournamentRoster[]       @relation("RosterLocker")
  rosterEntries          TournamentRosterEntry[]
  matchMapPlayers        MatchMapPlayer[]
  vetoActions            MapVetoAction[]
  serverAllocations      ServerAllocation[]
  serverCommandRequests  ServerCommandRequest[]
  playerMapStats         PlayerMapStat[]
  playerRoundStats       PlayerRoundStat[]
  auditLogs              AuditLog[]

  @@index([status])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 (or HMAC) of the opaque session token. The raw token is never stored.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model SteamProfile {
  id               String             @id @default(uuid(7)) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  steamDisplayName String?            @map("steam_display_name")
  avatarUrl        String?            @map("avatar_url")
  profileUrl       String?            @map("profile_url")
  privacyStatus    SteamPrivacyStatus @default(UNKNOWN) @map("privacy_status")
  syncedAt         DateTime?          @map("synced_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("steam_profiles")
}

model PlayerProfile {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  nickname    String   @db.VarChar(32)
  /// Lowercase URL slug (CHECK enforced in SQL).
  slug        String   @unique @db.VarChar(64)
  /// ISO 3166-1 alpha-2, uppercase.
  countryCode String?  @map("country_code") @db.Char(2)
  biography   String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([nickname])
  @@map("player_profiles")
}

model UserRoleGrant {
  id          String        @id @default(uuid(7)) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        RoleType
  scopeType   RoleScopeType @default(GLOBAL) @map("scope_type")
  /// Id of the scoped resource (team/tournament/match); NULL iff scope_type = GLOBAL (CHECK).
  scopeId     String?       @map("scope_id") @db.Uuid
  issuedById  String?       @map("issued_by") @db.Uuid
  issuedAt    DateTime      @default(now()) @map("issued_at") @db.Timestamptz(6)
  reason      String?
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedById String?       @map("revoked_by") @db.Uuid

  user      User  @relation("RoleGrantUser", fields: [userId], references: [id], onDelete: Restrict)
  issuedBy  User? @relation("RoleGrantIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  revokedBy User? @relation("RoleGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([issuedById])
  @@index([revokedById])
  @@index([role, scopeType, scopeId])
  @@map("user_role_grants")
}

// ============================================================================
// Teams
// ============================================================================

model TeamApplication {
  id              String                @id @default(uuid(7)) @db.Uuid
  applicantUserId String                @map("applicant_user_id") @db.Uuid
  requestedName   String                @map("requested_name") @db.VarChar(64)
  requestedTag    String                @map("requested_tag") @db.VarChar(10)
  requestedSlug   String                @map("requested_slug") @db.VarChar(64)
  countryCode     String?               @map("country_code") @db.Char(2)
  description     String?
  logoKey         String?               @map("logo_key")
  status          TeamApplicationStatus @default(PENDING)
  reviewedById    String?               @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewReason    String?               @map("review_reason")
  /// Team created by approval. UNIQUE ⇒ an application can produce at most one team.
  createdTeamId   String?               @unique @map("created_team_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  applicant   User  @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedBy  User? @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdTeam Team? @relation(fields: [createdTeamId], references: [id], onDelete: Restrict)

  @@index([applicantUserId])
  @@index([reviewedById])
  @@index([status, createdAt])
  @@map("team_applications")
}

model Team {
  id          String     @id @default(uuid(7)) @db.Uuid
  /// Lowercase slug; also unique case-insensitively (SQL).
  slug        String     @unique @db.VarChar(64)
  /// Unique; also unique case-insensitively via lower(name) (SQL).
  name        String     @unique @db.VarChar(64)
  /// Unique case-insensitively via lower(tag) (SQL).
  tag         String     @db.VarChar(10)
  countryCode String?    @map("country_code") @db.Char(2)
  region      String?    @db.VarChar(32)
  logoKey     String?    @map("logo_key")
  description String?
  status      TeamStatus @default(ACTIVE)
  isSample    Boolean    @default(false) @map("is_sample")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  application      TeamApplication?
  memberships      TeamMembership[]
  invitations      TeamInvitation[]
  staff            TeamStaff[]
  achievements     TeamAchievement[]
  rankingSnapshots TeamRankingSnapshot[]
  registrations    TournamentRegistration[]
  matchesAsTeamA   Match[]                  @relation("MatchTeamA")
  matchesAsTeamB   Match[]                  @relation("MatchTeamB")
  matchesWon       Match[]                  @relation("MatchWinner")
  matchRosters     MatchRoster[]
  mapsWon          MatchMap[]               @relation("MatchMapWinner")
  mapsStartedCt    MatchMap[]               @relation("MatchMapStartingCt")
  matchMapPlayers  MatchMapPlayer[]
  vetoActions      MapVetoAction[]
  roundsWon        MatchRound[]
  playerMapStats   PlayerMapStat[]
  teamMapStats     TeamMapStat[]

  @@index([status])
  @@map("teams")
}

/// Historic + current memberships. Active ⇔ left_at IS NULL.
/// SQL: one active membership per user; one active CAPTAIN per team.
model TeamMembership {
  id           String         @id @default(uuid(7)) @db.Uuid
  teamId       String         @map("team_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  role         MembershipRole
  joinedAt     DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt       DateTime?      @map("left_at") @db.Timestamptz(6)
  leftReason   String?        @map("left_reason")
  invitedById  String?        @map("invited_by") @db.Uuid
  /// Invitation that produced this membership. UNIQUE ⇒ accepting is idempotent.
  invitationId String?        @unique @map("invitation_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user       User            @relation("MembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  invitedBy  User?           @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  invitation TeamInvitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([teamId, leftAt])
  @@index([userId, joinedAt])
  @@index([invitedById])
  @@map("team_memberships")
}

/// SQL: one PENDING invitation per (team, invitee).
model TeamInvitation {
  id            String           @id @default(uuid(7)) @db.Uuid
  teamId        String           @map("team_id") @db.Uuid
  inviteeUserId String           @map("invitee_user_id") @db.Uuid
  invitedById   String           @map("invited_by") @db.Uuid
  role          MembershipRole   @default(PLAYER)
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt   DateTime?        @map("responded_at") @db.Timestamptz(6)

  team       Team            @relation(fields: [teamId], references: [id], onDelete: Restrict)
  invitee    User            @relation("InvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  invitedBy  User            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  membership TeamMembership?

  @@index([teamId, status])
  @@index([inviteeUserId, status])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@map("team_invitations")
}

model TeamStaff {
  id        String    @id @default(uuid(7)) @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      StaffRole
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([teamId, validTo])
  @@index([userId])
  @@map("team_staff")
}

model TeamAchievement {
  id           String   @id @default(uuid(7)) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  tournamentId String   @map("tournament_id") @db.Uuid
  placement    Int
  prizeAmount  Decimal? @map("prize_amount") @db.Decimal(14, 2)
  /// ISO 4217, uppercase.
  currencyCode String?  @map("currency_code") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@unique([teamId, tournamentId])
  @@index([tournamentId])
  @@map("team_achievements")
}

/// Recalculable ranking output. Always labelled with the RAGE algorithm version.
model TeamRankingSnapshot {
  id               String   @id @default(uuid(7)) @db.Uuid
  teamId           String   @map("team_id") @db.Uuid
  rank             Int
  region           String?  @db.VarChar(32)
  algorithmVersion String   @map("algorithm_version") @db.VarChar(32)
  points           Decimal  @db.Decimal(12, 4)
  calculatedAt     DateTime @map("calculated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([teamId, calculatedAt])
  @@index([algorithmVersion, region, calculatedAt, rank])
  @@map("team_ranking_snapshots")
}

// ============================================================================
// Tournaments
// ============================================================================

model Tournament {
  id                  String           @id @default(uuid(7)) @db.Uuid
  slug                String           @unique @db.VarChar(96)
  name                String           @db.VarChar(128)
  format              BracketFormat
  status              TournamentStatus @default(DRAFT)
  defaultMatchFormat  MatchFormat      @default(BO1) @map("default_match_format")
  maxTeams            Int?             @map("max_teams")
  registrationOpenAt  DateTime?        @map("registration_open_at") @db.Timestamptz(6)
  registrationCloseAt DateTime?        @map("registration_close_at") @db.Timestamptz(6)
  startsAt            DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt              DateTime?        @map("ends_at") @db.Timestamptz(6)
  /// Rules (roster size, substitutes policy, map pool, …). Validated by the API.
  settingsJson        Json             @default("{}") @map("settings_json")
  createdById         String?          @map("created_by") @db.Uuid
  isSample            Boolean          @default(false) @map("is_sample")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy     User?                    @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  stages        TournamentStage[]
  registrations TournamentRegistration[]
  matches       Match[]
  achievements  TeamAchievement[]

  @@index([status, startsAt])
  @@index([createdById])
  @@map("tournaments")
}

model TournamentStage {
  id           String        @id @default(uuid(7)) @db.Uuid
  tournamentId String        @map("tournament_id") @db.Uuid
  name         String        @db.VarChar(64)
  format       BracketFormat
  sequence     Int
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  brackets   Bracket[]
  matches    Match[]

  @@unique([tournamentId, sequence])
  @@map("tournament_stages")
}

model TournamentRegistration {
  id            String             @id @default(uuid(7)) @db.Uuid
  tournamentId  String             @map("tournament_id") @db.Uuid
  teamId        String             @map("team_id") @db.Uuid
  requestedById String             @map("requested_by") @db.Uuid
  status        RegistrationStatus @default(PENDING)
  seed          Int?
  reviewedById  String?            @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  reviewReason  String?            @map("review_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tournament  Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Restrict)
  requestedBy User               @relation("RegistrationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?              @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  rosters     TournamentRoster[]

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status])
  @@index([teamId])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("tournament_registrations")
}

/// Versioned roster snapshot for a registration. SQL: at most one LOCKED roster per registration.
/// Entries are immutable once locked (service-enforced); substitutions create a new version.
model TournamentRoster {
  id                 String       @id @default(uuid(7)) @db.Uuid
  registrationId     String       @map("tournament_registration_id") @db.Uuid
  version            Int
  status             RosterStatus @default(DRAFT)
  lockedAt           DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedById         String?      @map("locked_by") @db.Uuid
  supersedesRosterId String?      @unique @map("supersedes_roster_id") @db.Uuid
  changeReason       String?      @map("change_reason")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  registration TournamentRegistration  @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  lockedBy     User?                   @relation("RosterLocker", fields: [lockedById], references: [id], onDelete: Restrict)
  supersedes   TournamentRoster?       @relation("RosterSupersedes", fields: [supersedesRosterId], references: [id], onDelete: Restrict)
  supersededBy TournamentRoster?       @relation("RosterSupersedes")
  entries      TournamentRosterEntry[]
  matchRosters MatchRoster[]

  @@unique([registrationId, version])
  @@index([lockedById])
  @@map("tournament_rosters")
}

model TournamentRosterEntry {
  id                String          @id @default(uuid(7)) @db.Uuid
  rosterId          String          @map("roster_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  steamId64Snapshot String          @map("steam_id64_snapshot") @db.VarChar(17)
  nicknameSnapshot  String          @map("nickname_snapshot") @db.VarChar(32)
  role              RosterEntryRole
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  roster TournamentRoster @relation(fields: [rosterId], references: [id], onDelete: Restrict)
  user   User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([rosterId, userId])
  @@unique([rosterId, steamId64Snapshot])
  @@index([userId])
  @@map("tournament_roster_entries")
}

model Bracket {
  id                String   @id @default(uuid(7)) @db.Uuid
  stageId           String   @map("tournament_stage_id") @db.Uuid
  generationVersion Int      @map("generation_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  stage TournamentStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  slots BracketSlot[]

  @@unique([stageId, generationVersion])
  @@map("brackets")
}

/// A position in a bracket. The match played in this slot references it via matches.bracket_slot_id.
/// next_slot_id/next_slot_position: where the winner advances; loser_next_slot_* for double-elim.
model BracketSlot {
  id                    String        @id @default(uuid(7)) @db.Uuid
  bracketId             String        @map("bracket_id") @db.Uuid
  roundNumber           Int           @map("round_number")
  slotNumber            Int           @map("slot_number")
  nextSlotId            String?       @map("next_slot_id") @db.Uuid
  nextSlotPosition      TeamPosition? @map("next_slot_position")
  loserNextSlotId       String?       @map("loser_next_slot_id") @db.Uuid
  loserNextSlotPosition TeamPosition? @map("loser_next_slot_position")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  bracket        Bracket       @relation(fields: [bracketId], references: [id], onDelete: Restrict)
  nextSlot       BracketSlot?  @relation("SlotNext", fields: [nextSlotId], references: [id], onDelete: Restrict)
  previousSlots  BracketSlot[] @relation("SlotNext")
  loserNextSlot  BracketSlot?  @relation("SlotLoserNext", fields: [loserNextSlotId], references: [id], onDelete: Restrict)
  loserFromSlots BracketSlot[] @relation("SlotLoserNext")
  match          Match?

  @@unique([bracketId, roundNumber, slotNumber])
  @@index([nextSlotId])
  @@index([loserNextSlotId])
  @@map("bracket_slots")
}

// ============================================================================
// Matches
// ============================================================================

/// A series (BO1/BO3/BO5). Per-map data lives in MatchMap.
model Match {
  id               String      @id @default(uuid(7)) @db.Uuid
  tournamentId     String?     @map("tournament_id") @db.Uuid
  stageId          String?     @map("stage_id") @db.Uuid
  bracketSlotId    String?     @unique @map("bracket_slot_id") @db.Uuid
  /// Nullable while a bracket slot awaits its participant (TBD).
  teamAId          String?     @map("team_a_id") @db.Uuid
  teamBId          String?     @map("team_b_id") @db.Uuid
  format           MatchFormat @default(BO1)
  status           MatchStatus @default(CREATED)
  /// Maps won in the series; NULL until the series has server-confirmed map results.
  teamAScore       Int?        @map("team_a_score")
  teamBScore       Int?        @map("team_b_score")
  winnerTeamId     String?     @map("winner_team_id") @db.Uuid
  scheduledAt      DateTime?   @map("scheduled_at") @db.Timestamptz(6)
  startedAt        DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?   @map("completed_at") @db.Timestamptz(6)
  resultVerifiedAt DateTime?   @map("result_verified_at") @db.Timestamptz(6)
  statusReason     String?     @map("status_reason")
  /// Optimistic concurrency counter for state transitions.
  version          Int         @default(0)
  isSample         Boolean     @default(false) @map("is_sample")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tournament  Tournament?            @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  stage       TournamentStage?       @relation(fields: [stageId], references: [id], onDelete: Restrict)
  bracketSlot BracketSlot?           @relation(fields: [bracketSlotId], references: [id], onDelete: Restrict)
  teamA       Team?                  @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Restrict)
  teamB       Team?                  @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Restrict)
  winnerTeam  Team?                  @relation("MatchWinner", fields: [winnerTeamId], references: [id], onDelete: Restrict)
  rosters     MatchRoster[]
  maps        MatchMap[]
  vetoActions MapVetoAction[]
  allocations ServerAllocation[]
  commands    ServerCommandRequest[]
  events      MatchEvent[]

  @@index([tournamentId, status])
  @@index([stageId])
  @@index([teamAId, scheduledAt])
  @@index([teamBId, scheduledAt])
  @@index([winnerTeamId])
  @@index([status, scheduledAt])
  @@map("matches")
}

/// Lineup frozen for a match, derived from the locked tournament roster.
model MatchRoster {
  id                 String    @id @default(uuid(7)) @db.Uuid
  matchId            String    @map("match_id") @db.Uuid
  teamId             String    @map("team_id") @db.Uuid
  tournamentRosterId String?   @map("tournament_roster_id") @db.Uuid
  frozenAt           DateTime? @map("frozen_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  match            Match             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  team             Team              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  tournamentRoster TournamentRoster? @relation(fields: [tournamentRosterId], references: [id], onDelete: Restrict)

  @@unique([matchId, teamId])
  @@index([teamId])
  @@index([tournamentRosterId])
  @@map("match_rosters")
}

model MatchMap {
  id               String         @id @default(uuid(7)) @db.Uuid
  matchId          String         @map("match_id") @db.Uuid
  /// 1-based order within the series.
  mapOrder         Int            @map("map_order")
  mapName          String         @map("map_name") @db.VarChar(64)
  status           MatchMapStatus @default(PENDING)
  teamAScore       Int            @default(0) @map("team_a_score")
  teamBScore       Int            @default(0) @map("team_b_score")
  winnerTeamId     String?        @map("winner_team_id") @db.Uuid
  startingCtTeamId String?        @map("starting_ct_team_id") @db.Uuid
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  match          Match            @relation(fields: [matchId], references: [id], onDelete: Restrict)
  winnerTeam     Team?            @relation("MatchMapWinner", fields: [winnerTeamId], references: [id], onDelete: Restrict)
  startingCtTeam Team?            @relation("MatchMapStartingCt", fields: [startingCtTeamId], references: [id], onDelete: Restrict)
  players        MatchMapPlayer[]
  rounds         MatchRound[]
  events         MatchEvent[]
  playerStats    PlayerMapStat[]
  teamStats      TeamMapStat[]
  demos          Demo[]

  @@unique([matchId, mapOrder])
  @@index([winnerTeamId])
  @@index([startingCtTeamId])
  @@index([mapName])
  @@map("match_maps")
}

model MatchMapPlayer {
  id                String    @id @default(uuid(7)) @db.Uuid
  matchMapId        String    @map("match_map_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  teamId            String    @map("team_id") @db.Uuid
  steamId64Snapshot String    @map("steam_id64_snapshot") @db.VarChar(17)
  nicknameSnapshot  String    @map("nickname_snapshot") @db.VarChar(32)
  sideInitial       TeamSide? @map("side_initial")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  matchMap MatchMap @relation(fields: [matchMapId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([matchMapId, userId])
  @@unique([matchMapId, steamId64Snapshot])
  @@index([userId])
  @@index([teamId])
  @@map("match_map_players")
}

/// SQL: a map can be banned/picked/decided at most once per match (partial unique).
model MapVetoAction {
  id          String         @id @default(uuid(7)) @db.Uuid
  matchId     String         @map("match_id") @db.Uuid
  sequence    Int
  actorTeamId String?        @map("actor_team_id") @db.Uuid
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      VetoActionType
  mapName     String         @map("map_name") @db.VarChar(64)
  /// Chosen starting side (SIDE_PICK only).
  side        TeamSide?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  match     Match @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actorTeam Team? @relation(fields: [actorTeamId], references: [id], onDelete: Restrict)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([matchId, sequence])
  @@index([actorTeamId])
  @@index([actorUserId])
  @@map("map_veto_actions")
}

model MatchRound {
  id            String          @id @default(uuid(7)) @db.Uuid
  matchMapId    String          @map("match_map_id") @db.Uuid
  roundNumber   Int             @map("round_number")
  winningTeamId String?         @map("winning_team_id") @db.Uuid
  winningSide   TeamSide?       @map("winning_side")
  winReason     RoundWinReason? @map("win_reason")
  startedAt     DateTime?       @map("started_at") @db.Timestamptz(6)
  endedAt       DateTime?       @map("ended_at") @db.Timestamptz(6)

  matchMap    MatchMap          @relation(fields: [matchMapId], references: [id], onDelete: Restrict)
  winningTeam Team?             @relation(fields: [winningTeamId], references: [id], onDelete: Restrict)
  playerStats PlayerRoundStat[]

  @@unique([matchMapId, roundNumber])
  @@index([winningTeamId])
  @@map("match_rounds")
}

// ============================================================================
// Game servers
// ============================================================================

model GameServer {
  id           String             @id @default(uuid(7)) @db.Uuid
  name         String             @unique @db.VarChar(64)
  providerType ServerProviderType @map("provider_type")
  /// Host/IP players connect to (game traffic). RCON is never exposed or stored here.
  address      String             @db.VarChar(255)
  gamePort     Int                @map("game_port")
  region       String?            @db.VarChar(32)
  enabled      Boolean            @default(true)
  status       GameServerStatus   @default(UNKNOWN)
  /// Reference to a secret held by the server agent / secret manager (e.g. "vault:kv/servers/<id>").
  /// NEVER a plaintext RCON or server password.
  secretRef    String?            @map("secret_ref")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  agents      ServerAgent[]
  allocations ServerAllocation[]
  commands    ServerCommandRequest[]
  events      MatchEvent[]

  @@index([enabled, status])
  @@map("game_servers")
}

model ServerAgent {
  id                String            @id @default(uuid(7)) @db.Uuid
  gameServerId      String            @map("game_server_id") @db.Uuid
  /// Agent identity (e.g. public-key fingerprint). Unique across all agents.
  agentIdentity     String            @unique @map("agent_identity")
  version           String?           @db.VarChar(64)
  gamePluginVersion String?           @map("game_plugin_version") @db.VarChar(64)
  lastHeartbeatAt   DateTime?         @map("last_heartbeat_at") @db.Timestamptz(6)
  status            ServerAgentStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt         DateTime?         @map("revoked_at") @db.Timestamptz(6)

  gameServer GameServer @relation(fields: [gameServerId], references: [id], onDelete: Restrict)

  @@index([gameServerId])
  @@index([status, lastHeartbeatAt])
  @@map("server_agents")
}

/// Lease of a server for a match. Active ⇔ released_at IS NULL.
/// SQL: at most one active allocation per server and per match.
model ServerAllocation {
  id             String    @id @default(uuid(7)) @db.Uuid
  serverId       String    @map("server_id") @db.Uuid
  matchId        String    @map("match_id") @db.Uuid
  allocatedById  String?   @map("allocated_by") @db.Uuid
  leaseExpiresAt DateTime  @map("lease_expires_at") @db.Timestamptz(6)
  allocatedAt    DateTime  @default(now()) @map("allocated_at") @db.Timestamptz(6)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)
  releaseReason  String?   @map("release_reason")

  server      GameServer @relation(fields: [serverId], references: [id], onDelete: Restrict)
  match       Match      @relation(fields: [matchId], references: [id], onDelete: Restrict)
  allocatedBy User?      @relation(fields: [allocatedById], references: [id], onDelete: Restrict)

  @@index([serverId, allocatedAt])
  @@index([matchId])
  @@index([allocatedById])
  @@index([leaseExpiresAt])
  @@map("server_allocations")
}

/// Allowlisted command envelope. No free-form command text; `payload` holds typed params.
model ServerCommandRequest {
  id             String             @id @default(uuid(7)) @db.Uuid
  serverId       String             @map("server_id") @db.Uuid
  matchId        String?            @map("match_id") @db.Uuid
  actorUserId    String?            @map("actor_user_id") @db.Uuid
  commandType    ServerCommandType  @map("command_type")
  payload        Json               @default("{}")
  state          ServerCommandState @default(QUEUED)
  /// Client-provided idempotency key (optional); unique when present.
  idempotencyKey String?            @unique @map("idempotency_key") @db.VarChar(128)
  attempts       Int                @default(0)
  deadline       DateTime           @db.Timestamptz(6)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  ackAt          DateTime?          @map("ack_at") @db.Timestamptz(6)
  errorMessage   String?            @map("error_message")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  server    GameServer @relation(fields: [serverId], references: [id], onDelete: Restrict)
  match     Match?     @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actorUser User?      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([serverId, state, createdAt])
  @@index([matchId, createdAt])
  @@index([actorUserId])
  @@index([state, deadline])
  @@map("server_command_requests")
}

// ============================================================================
// Events & statistics
// ============================================================================

/// Raw game events. APPEND-ONLY (UPDATE/DELETE rejected by trigger). Dedup key: (source_server_id, external_event_id).
model MatchEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  sourceServerId  String   @map("source_server_id") @db.Uuid
  externalEventId String   @map("external_event_id") @db.VarChar(128)
  matchId         String   @map("match_id") @db.Uuid
  matchMapId      String?  @map("match_map_id") @db.Uuid
  eventType       String   @map("event_type") @db.VarChar(64)
  tick            Int?
  sequence        BigInt?
  schemaVersion   Int      @default(1) @map("schema_version")
  payloadJson     Json     @map("payload_json")
  occurredAt      DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  sourceServer GameServer @relation(fields: [sourceServerId], references: [id], onDelete: Restrict)
  match        Match      @relation(fields: [matchId], references: [id], onDelete: Restrict)
  matchMap     MatchMap?  @relation(fields: [matchMapId], references: [id], onDelete: Restrict)

  @@unique([sourceServerId, externalEventId])
  @@index([sourceServerId, sequence])
  @@index([matchId, sequence])
  @@index([matchMapId, tick])
  @@index([matchId, receivedAt])
  @@map("match_events")
}

/// Derived (rebuildable from match_events). Never seeded with fabricated values.
model PlayerMapStat {
  id            String   @id @default(uuid(7)) @db.Uuid
  matchMapId    String   @map("match_map_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  teamId        String   @map("team_id") @db.Uuid
  kills         Int      @default(0)
  deaths        Int      @default(0)
  assists       Int      @default(0)
  headshots     Int      @default(0)
  damage        Int      @default(0)
  roundsPlayed  Int      @default(0) @map("rounds_played")
  kastRounds    Int      @default(0) @map("kast_rounds")
  openingKills  Int      @default(0) @map("opening_kills")
  openingDeaths Int      @default(0) @map("opening_deaths")
  utilityDamage Int      @default(0) @map("utility_damage")
  clutchWins    Int      @default(0) @map("clutch_wins")
  /// RAGE Rating (own documented algorithm; NOT an HLTV rating).
  ratingValue   Decimal? @map("rating_value") @db.Decimal(6, 3)
  ratingVersion String?  @map("rating_version") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matchMap MatchMap @relation(fields: [matchMapId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([matchMapId, userId])
  @@index([userId, createdAt])
  @@index([teamId])
  @@map("player_map_stats")
}

model PlayerRoundStat {
  id           String  @id @default(uuid(7)) @db.Uuid
  matchRoundId String  @map("match_round_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  kills        Int     @default(0)
  deaths       Int     @default(0)
  assists      Int     @default(0)
  damage       Int     @default(0)
  /// Bitmask: 1=Kill, 2=Assist, 4=Survived, 8=Traded (documented in statistics docs).
  kastFlags    Int     @default(0) @map("kast_flags")
  survived     Boolean @default(false)
  traded       Boolean @default(false)

  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchRoundId, userId])
  @@index([userId])
  @@map("player_round_stats")
}

model TeamMapStat {
  id          String   @id @default(uuid(7)) @db.Uuid
  matchMapId  String   @map("match_map_id") @db.Uuid
  teamId      String   @map("team_id") @db.Uuid
  roundsWon   Int      @default(0) @map("rounds_won")
  ctRoundsWon Int      @default(0) @map("ct_rounds_won")
  tRoundsWon  Int      @default(0) @map("t_rounds_won")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  matchMap MatchMap @relation(fields: [matchMapId], references: [id], onDelete: Restrict)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([matchMapId, teamId])
  @@index([teamId])
  @@map("team_map_stats")
}

/// Demo metadata. Bytes live in object storage (object_key), never in the database.
model Demo {
  id            String     @id @default(uuid(7)) @db.Uuid
  matchMapId    String     @map("match_map_id") @db.Uuid
  objectKey     String     @unique @map("object_key")
  sha256        String?    @db.Char(64)
  bytes         BigInt?
  status        DemoStatus @default(PENDING_UPLOAD)
  parserVersion String?    @map("parser_version") @db.VarChar(32)
  uploadedAt    DateTime?  @map("uploaded_at") @db.Timestamptz(6)
  processedAt   DateTime?  @map("processed_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  matchMap MatchMap @relation(fields: [matchMapId], references: [id], onDelete: Restrict)

  @@index([matchMapId])
  @@index([status])
  @@map("demos")
}

// ============================================================================
// Audit & outbox
// ============================================================================

/// APPEND-ONLY (UPDATE/DELETE rejected by trigger).
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  /// Dotted action code, e.g. "team_application.approve".
  action       String   @db.VarChar(96)
  resourceType String   @map("resource_type") @db.VarChar(64)
  resourceId   String?  @map("resource_id") @db.VarChar(128)
  requestId    String?  @map("request_id") @db.VarChar(128)
  detailJson   Json     @default("{}") @map("detail_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Transactional outbox for reliable event publication (written in the same tx as the change).
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  topic       String    @db.VarChar(128)
  resourceId  String?   @map("resource_id") @db.VarChar(128)
  payloadJson Json      @map("payload_json")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([topic, createdAt])
  @@map("outbox_events")
}
