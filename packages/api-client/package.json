{
  "name": "@rage/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts --alphabetize && prettier --write src/schema.ts openapi.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.json && node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  },
  "description": "Typed RAGE API client generated from the API OpenAPI document",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ]
}
