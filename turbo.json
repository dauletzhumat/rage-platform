{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_INTERNAL_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "^generate", "generate"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "MIGRATION_DATABASE_URL",
        "RAGE_APP_DB_PASSWORD",
        "RAGE_APP_DB_ROLE"
      ],
      "passThroughEnv": [
        "STEAM_*",
        "SESSION_*",
        "WEB_PUBLIC_URL",
        "COOKIE_SECURE",
        "INTERNAL_SSR_TOKEN",
        "BOOTSTRAP_SUPER_ADMIN_STEAM_ID64"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
