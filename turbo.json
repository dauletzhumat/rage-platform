{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_INTERNAL_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "^generate", "generate"],
      "cache": false,
      "env": ["DATABASE_URL", "REDIS_URL", "TEST_DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate"],
      "cache": false,
      "persistent": true
    }
  }
}
